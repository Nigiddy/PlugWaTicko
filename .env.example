# ==============================================================================
# TicketPlug - Environment Variables Configuration
# Copy this file to .env and adjust values for your environment (Docker or Bare-Metal)
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# Options: development, testing, production
DJANGO_ENV=development

# Security key: generate a strong 50+ character random string for production
SECRET_KEY=django-insecure-local-dev-secret-key-change-in-production-min-32-chars

# Debug mode (set to False in production)
DEBUG=True

# Allowed Hosts & CORS Whitelist (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ticket-plug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend URL (used for constructing ticket verification links)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# POSTGRES_DB is used by the official PostgreSQL Docker container
# POSTGRES_NAME is read by Django settings
POSTGRES_DB=ticketplug
POSTGRES_NAME=ticketplug
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# For Docker Compose: POSTGRES_HOST is automatically routed to 'db'
# For bare-metal host development: use 'localhost'
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Celery Background Task Processing
# ------------------------------------------------------------------------------
# For Docker Compose: route to service hostname 'redis'
# For bare-metal host development: use 'redis://127.0.0.1:6379/0'
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Paystack Payment Gateway
# ------------------------------------------------------------------------------
# Obtain test credentials from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_placeholder_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_public_key_here

# ------------------------------------------------------------------------------
# Automatic Initial Superuser Creation (server.sh)
# ------------------------------------------------------------------------------
# Automatically created on first container boot if both are set
DJANGO_SUPERUSER_EMAIL=admin@ticketplug.com
DJANGO_SUPERUSER_PASSWORD=AdminSecurePassword123!

# ------------------------------------------------------------------------------
# Email Service (SMTP / Gmail)
# ------------------------------------------------------------------------------
# In development, leave blank to use console email backend (outputs to logs)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Optional)
# ------------------------------------------------------------------------------
CLOUD_NAME=mock_cloud
CLOUD_API_KEY=mock_key
CLOUD_API_SECRET=mock_secret

